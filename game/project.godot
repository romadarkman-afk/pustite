; «Пустите» v0.11.0
; Баланс: config/*.tres (ресурсы GameConfig). Правила: scripts/core/match.gd.
; Растягивать узлы только через set_anchors_and_offsets_preset — см. Task 1.

config_version=5

[application]

config/name="Пустите"
config/description="Социальная дедукция с убежищами"
config/version="0.11.0"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"
config/quit_on_go_back=false
run/max_fps=60
boot_splash/bg_color=Color(0.039, 0.063, 0.075, 1)
boot_splash/show_image=false

[autoload]

Diag="*res://scripts/autoload/diag.gd"
Juice="*res://scripts/autoload/juice.gd"
Save="*res://scripts/autoload/save.gd"
Game="*res://scripts/autoload/game.gd"
Nav="*res://scripts/autoload/nav.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=false

[physics]

common/physics_ticks_per_second=30

[input_devices]

pointing/emulate_touch_from_mouse=true

[gui]

common/drop_mouse_on_gui_input_disabled=true
timers/tooltip_delay_sec=99.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=0
environment/defaults/default_clear_color=Color(0.039, 0.063, 0.075, 1)
