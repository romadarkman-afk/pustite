		"list.cant": "आज नहीं: सूची भरी है या आज तुम यह कर चुके हो।",
		"sc.betray.1": "प्लेटफ़ॉर्म पर सुबह। पटरियों पर धुंध है। स्टेशन मास्टर सूची पकड़े एक पंक्ति को देर तक देखता है।",
		"sc.betray.2": "यह पंक्ति रात में लिखी गई। लिखावट मैं पहचानता हूँ। यह {who} की है।",
		"sc.betray.human": "मैं ट्रेन तक ज़िंदा रहना चाहता था। जिससे डर था, उसका नाम लिख दिया ताकि वह मुझे न छुए। मेरी जगह कोई भी यही करता।",
		"sc.betray.upyr": "इस पूरे रास्ते मैं तुम्हारा दोस्त बना रहा। मुश्किल नहीं था। मुझे बस डिब्बे में जगह चाहिए थी।",
		"sc.betray.clerk": "मुझे पैसे मिले। मैं मुंशी हूँ, जिसके पैसे मिलते हैं वही लिखता हूँ। कौन दे रहा है, मुझे फ़र्क नहीं पड़ता।",
		"sc.betray.ask": "{who} के बारे में क्या कहोगे?",
		"sc.betray.c_expose": "सबको बता दो",
		"sc.betray.c_cover": "बचा लो",
		"sc.final.1": "ट्रेन से पहले की आख़िरी रात। स्टेशन सो रहा है। दरवाज़े पर तीन बार दस्तक होती है, जैसे पहली रात हुई थी।",
		"sc.final.voice": "मैं हूँ, {who}। खोलो। इतने समय से मैं उस पार तुम्हारा इंतज़ार कर रहा था।",
		"sc.final.voice_self": "दरवाज़े के पीछे तुम्हारी अपनी आवाज़ तुम्हें नाम से पुकारती है। वही जो गिरजे की तख़्ती पर खुदा है।",
		"sc.final.2": "दूर कहीं ट्रेन की सीटी बजती है। भोर से पहले वह प्लेटफ़ॉर्म पर होगी।",
		"sc.final.ask": "क्या करोगे?",
		"sc.final.c_open": "खोलो और चले जाओ",
		"sc.final.c_train": "मत खोलो, ट्रेन का इंतज़ार करो",
