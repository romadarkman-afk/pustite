		## Группа 7 плана: станция, люди станции, список, последний поезд, финал (TASK-031–035)
		"npc.keeper.name": "स्टेशन मास्टर",
		"npc.keeper.q_list": "ट्रेन की सूची",
		"npc.keeper.q_train": "ट्रेन कब आएगी?",
		"npc.keeper.q_night": "रात में कौन दस्तक देता है?",
		"npc.keeper.a_list_early": "सूची ट्रेन से ठीक पहले बनेगी। लिखेगा मुंशी, मैं नहीं। उस पर नज़र रखो।",
		"npc.keeper.a_list_list": "सूची मेरे पास है। खुद देख लो।",
		"npc.keeper.a_train": "तीन दिन से तार चुप है। चाबी मेरे पास है, पर जवाब कोई नहीं देता। ट्रेन आएगी। सवाल यह है कि किसके साथ।",
		"npc.keeper.a_night": "रात में पटरियों पर वे चलते हैं जो ट्रेन तक नहीं पहुँचे। वे जानते हैं कि जगह कम है।",
		"npc.keeper.open_a4c1": "यह आख़िरी स्टेशन है। आगे जंगल नहीं, सिर्फ़ पटरियाँ। ट्रेन चार रात बाद आने का वादा है।",
		"npc.keeper.open_a4c2": "सूची शुरू करते हैं। जगह तुमसे कम है। मुंशी लिखेगा, मैं देखूँगा।",
