## 简体中文。一个传说里的村子：熊猫滚滚、戴金箍的悟空、猪八戒、福娃阿福、花木兰和嫦娥。
## 怪物是僵尸，护身靠门上的符。玩家是「你」。名字不变格，列举用「、」和「和」。


func code() -> String:
	return "zh"


func plural_index(_n: int) -> int:
	return 0


func join(parts: PackedStringArray) -> String:
	if parts.size() <= 1:
		return "".join(parts)
	return "、".join(parts.slice(0, parts.size() - 1)) + "和" + parts[parts.size() - 1]


func cap(s: String) -> String:
	return s


