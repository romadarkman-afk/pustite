## Характер жителя по его личной истории; если истории нет — по имени.
static func persona_for(story_id: int, name: String) -> int:
	if story_id >= 0:
		return BY_STORY[posmod(story_id, BY_STORY.size())]
	return posmod(name.hash(), Persona.size())


static func random_persona(rng: RandomNumberGenerator) -> int:
	return rng.randi_range(int(Persona.QUIET), int(Persona.YOUNG))


## Строки характера для банка (только по-русски; на других языках пусто).
static func lines(persona: int, bank: String) -> PackedStringArray:
	if L.code != "ru" or persona < 0:
		return PackedStringArray()
	var p: Dictionary = RU.get(persona, {})
	return PackedStringArray(p.get(bank, []))


## Сколько всего строк у характеров — для самотеста объёма.
static func total() -> int:
	var n := 0
	for p: int in RU:
		for bank: String in RU[p]:
			n += (RU[p][bank] as Array).size()
	return n
