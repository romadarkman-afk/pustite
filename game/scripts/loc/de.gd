		"ach.mourning.name": "Trauer",
		"ach.mourning.desc": "Sehen, wie das Dorf einen geliebten Menschen begräbt.",
		"ach.last_one.name": "Die Letzten",
		"ach.last_one.desc": "Durchhalten, wenn nur noch zwei Menschen oder weniger übrig sind.",
