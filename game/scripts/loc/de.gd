		"camp.replay": "Nochmal spielen",
		"camp.replay_ask": "Kapitel „{title}“ noch einmal spielen? Die besten Sterne bleiben. Wer stirbt und was du entscheidest, wird nicht in die Geschichte des Dorfes geschrieben.",
		"camp.replay_yes": "Spielen",
		"camp.replay_note": "Kapitel wiederholt. Tote und Entscheidungen werden nicht in die Geschichte übernommen. Bestes Ergebnis: {stars}.",
		"camp.a1c1.title": "Das Klopfen",
		"camp.a1c1.desc": "Deine erste Nacht im Dorf. Es klopft, und du kennst die Regeln noch nicht.",
		"camp.a1c1.beat1_title": "Das Klopfen",
		"camp.a1c1.beat1": "Der Ofen ist noch nicht warm, und schon klopft es an der Tür.",
		"camp.a1c1.beat2_title": "Die Regeln",
		"camp.a1c1.beat2": "Die Regeln lernst du unterwegs. Entscheide zuerst, ob du öffnest.",
		"camp.a1c2.title": "Nebel",
		"camp.a1c2.desc": "Zwei kommen von der Landstraße. Vom Fluss steigt Nebel auf, und der Werwolf muss vor der dritten Nacht gefunden werden.",
		"camp.a1c2.beat1_title": "Kapitel 2. Nebel",
		"camp.a1c2.beat1": "Nach der ersten Nacht kamen zwei von der Landstraße. Sie sagen, im Nachbardorf öffnen sich die Türen nicht mehr.",
		"camp.a1c2.beat2_title": "Vor der dritten Nacht",
		"camp.a1c2.beat2": "Am Abend steigt Nebel vom Fluss auf. In solchen Nächten hört man die Glocke schlechter. Findet den Werwolf, bevor er euch findet.",
		"camp.a1c3.title": "Abschied",
		"camp.a1c3.desc": "Die letzten Nächte im Dorf. Es gibt jetzt zwei Werwölfe, und zur Mühle müssen alle gemeinsam.",
		"camp.a1c3.beat1_title": "Kapitel 3. Abschied",
		"camp.a1c3.beat1": "Der Dorfälteste hat entschieden: Überstehen wir diese Nächte, ziehen wir zur Mühle am Fluss. Hier können wir nicht bleiben.",
		"camp.a1c3.beat2_title": "Zwei",
		"camp.a1c3.beat2": "Es gibt jetzt zwei Werwölfe. Einer von euch ist nicht mehr einer von euch, und gestern habt ihr noch das Brot geteilt.",
		"camp.act1.end_all": "Fast das ganze Dorf zieht zur Mühle. In den leeren Häusern bleiben nur die Talismane.",
		"camp.act1.end_some": "Nur wenige ziehen zur Mühle. Niemand will zurückblicken.",
		"camp.act1.end_none": "Du gehst ohne die, mit denen du gekommen bist. Vom Dorf bleiben nur Namen.",
		"goal.people_win": "Die Menschen müssen durchhalten",
		"goal.survive": "Bis zum Ende überleben",
		"goal.exile_upyr_by_3": "Den Werwolf vor der dritten Nacht vertreiben",
		"goal.no_wrong_exile": "Keinen einzigen Menschen vertreiben",
