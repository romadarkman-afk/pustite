		## Группа 4 плана: туман, улики, пустая лодка, имя на доске, прощание (TASK-016–020)
		"clue.title": "Notizbuch der Spuren",
		"clue.btn": "Spuren ({n})",
		"clue.hint": "Wähle zwei Einträge. Widersprechen sie sich, frag die Person vor allen.",
		"clue.none": "Noch nichts aufzuschreiben. Hör zu, wer wo schlafen will, und achte darauf, wer nachts klopft.",
		"clue.day": "Tag {n}",
		"clue.claim": "{who.cap} sagt, {who:er schläft|sie schläft|du schläfst} heute {house.in}.",
		"clue.seen": "Nachts hat {who} an {house} geklopft.",
		"clue.say_home": "{who.cap} sagt, {who:er war|sie war|du warst} die ganze Nacht zu Hause.",
		"clue.find_tracks": "Am Steg frische Spuren von {who}. Jemand ist nachts in diesen Stiefeln zum Boot gegangen.",
		"clue.boat_oar": "Das Boot ist mit dem Bug zum Dorf festgemacht, gestern lag es anders. Das Ruder ist nass.",
		"clue.boat_scarf": "Im Boot liegt ein fremdes Tuch. Es ist trocken, obwohl das Boot die ganze Nacht auf dem Wasser lag.",
		"clue.no_conflict": "Diese Einträge widersprechen sich nicht.",
		"clue.conflict": "Die Einträge widersprechen sich. Du kannst vor allen fragen.",
		"clue.ask": "Vor allen fragen",
		"clue.token": "Widerspruchsmarke erhalten. Fragenmarken: {n}.",
		"clue.asked": "Danach wurde schon gefragt.",
		"say.confront": "{who}, bei mir steht das eine, passiert ist etwas anderes. Erklär es vor allen.",
		"ph.CLUE_ADMIT": ["Na gut. Ich war am Fluss, nach dem Boot sehen. Konnte nicht schlafen.", "Ja, ich habe gelogen. Ich hatte Angst, dass ihr mich verdächtigt.", "Stimmt. Vom anderen Ufer hat jemand gerufen, ich habe nachgesehen. Da war niemand."],
		"ph.CLUE_DENY": ["So etwas war nicht. Du verwechselst da was.", "Wem glaubst du, mir oder Spuren im Schlamm?", "Ich war zu Hause. Schluss."],
		"ph.MEM_WRONG": ["Natürlich weiß ich das noch. Mach auf, ich erzähl's dir später.", "Das Gespräch? Ja, ja. Mach auf, es ist kalt.", "Wir hatten doch eine Abmachung. Mach auf."],
		"door.mem_ask": "Worüber sprachen wir?",
		"door.mem_story": "„Heute ging es darum: {text}.“",
		"door.mem_promise": "„Wir haben heute etwas abgemacht. Ich weiß mein Wort noch.“",
		"door.mem_ok": "Die Stimme weiß, was nur ihr beide wusstet.",
		"door.mem_bad": "Die Stimme weicht aus. Wer heute mit dir geredet hat, wüsste es noch.",
		"door.fog_voice": "Eine Stimme im Nebel",
		"door.fog_claim": "Nennt sich {me}",
		"fog.teach": "Der Nebel ist da. Im Nebel lässt sich eine Stimme fälschen, die Erinnerung nicht. Frag an der Tür, was nur ihr beide wisst.",
		"fog.widow": "Mein Mann ist in so einen Nebel gegangen. Ich erkannte seine Stimme und machte auf. Er war es nicht.",
		"sc.board.1": "Sieh dir die unterste Zeile an. Ich wasche dieses Brett seit dreißig Jahren und sehe es erst jetzt.",
		"sc.board.2": "Auf dem Brett an der Kapelle, unter den Namen derer, die zum Fluss gingen, steht eingeritzt: „{name}“. Die Buchstaben sind alt und dunkel.",
		"sc.board.2_noname": "Auf dem Brett an der Kapelle, unter den Namen derer, die zum Fluss gingen, steht dein Name eingeritzt. Die Buchstaben sind alt und dunkel.",
		"sc.board.3": "Vor dreißig Jahren war schon jemand mit diesem Namen hier. Sag es ehrlich: bist du das?",
		"sc.board.alone": "An der Kapelle ist niemand. Am Brett liegen frische Späne: jemand hat die unterste Zeile freigekratzt.",
		"sc.board.ask": "Was antwortest du?",
		"sc.board.c_confess": "„Das ist mein Name. Ich erinnere mich an diesen Fluss.“",
		"sc.board.c_deny": "„Zufall. Der Name ist häufig.“",
		"sc.board.c_silent": "Schweigen",
		"sc.board.r_confess": "Dann hat der Fluss dich gehen lassen und ruft dich jetzt zurück. Ich sage es niemandem. Noch nicht.",
		"sc.board.r_deny": "Gut, ein Zufall. So ist mir wohler.",
		"sc.board.r_silent": "Du schweigst. Dann entscheide ich, was das heißt.",
		"day.p_send": "Mit dem Boot über den Fluss schicken",
		"day.send_ask": "Im Morgengrauen fährt {who} über den Fluss und kommt in diesem Kapitel nicht zurück. Wenn der Fluss es zulässt. Schicken?",
		"day.send_yes": "Schicken",
		"sys.send": "Im Morgengrauen fährt {who} über den Fluss.",
		"log.sent": "{who.cap} ist über den Fluss gefahren.",
		"log.sent_back": "{who.cap} ist zurück: das Boot hat mitten im Fluss gewendet.",
		"mo.sent": "{who.cap} ist im Morgengrauen abgefahren. Das Boot liegt schon leer am anderen Ufer.",
		"mo.sent_back": "{who.cap} steht wieder am Steg: das Boot hat mitten im Fluss von selbst gewendet. Der Fluss nimmt nicht jeden.",
		"farewell.warm": "Danke. Wenn ich zurückkomme, klopfe ich dreimal.",
		"farewell.cold": "Du willst mich loswerden. Gut, ich fahre.",
		"rev.boat_answer.title": "Wer das Boot brachte",
		"rev.boat_answer.text": "{who} schaut lange aufs Wasser: „Niemand hat das Boot gestohlen. Der, der dich vom anderen Ufer gerufen hat, hat es immer wieder herübergebracht. Er wartet, dass jemand von hier einsteigt. Er wartet noch.“",
		"rev.boat_answer.item": "Ruder, Tuch und Spuren am Steg passen zusammen: das Boot kam vom anderen Ufer. Wer dich beim Namen rief, wartet noch.",
		"camp.act1.boat": "Das Rätsel des leeren Boots ist gelöst: es kam vom anderen Ufer.",
		"camp.act1.boat_open": "Wer das leere Boot brachte, bleibt unbekannt.",
		"camp.act1.board_confess": "Der Name auf dem Brett gehört jetzt dir, und das Dorf weiß es.",
		"camp.act1.board_deny": "Der Name auf dem Brett blieb fremd. Vorerst.",
		"camp.act1.board_silent": "Der Name auf dem Brett bleibt ohne Antwort.",
		## Группа 5 плана: мельник, его тайна, чужаки, половодье, память акта I (TASK-021–025)
		"npc.miller.name": "Müller Sawelij",
		"npc.line": "{name}: „{text}“",
		"npc.busy": "{name} hat heute schon geantwortet. Frag morgen wieder.",
		"npc.miller.q_ford": "Was ist mit der Furt?",
		"npc.miller.q_before": "Wer war vor uns hier?",
		"npc.miller.q_night": "Wer klopft nachts?",
		"npc.miller.a_ford": "Das Wasser ist niedrig, knietief. Aber nachts gehen keine Menschen durch die Furt. Schließt ab.",
		"npc.miller.a_before": "Flüchtlinge. Sie blieben eine Weile und zogen flussaufwärts. Nicht alle sind angekommen, denke ich.",
		"npc.miller.a_before_known": "Jemand hat in mein Buch geschaut, sehe ich. Ja, sie haben bezahlt. Wer zahlte, kam rein. Frag nicht weiter.",
		"npc.miller.a_night": "Vom anderen Ufer kommt niemand, nachts hält das Wasser die Furt. Es klopfen nur die Eigenen. Oder die, die so tun.",
		"npc.miller.rule": "Ich habe eine Regel: nachts ist die Furt zu, geklopft wird nur von diesem Ufer. Wen du nicht kennst, lass nicht rein.",
		"npc.miller.board_confess": "Es heißt, dein Name steht auf dem Brett an der Kapelle. Also kommst du von dort. Ich merke es mir.",
		"npc.miller.board_deny": "Man hat mir vom Brett an der Kapelle erzählt. Du hältst es für Zufall, heißt es. Na ja.",
		"npc.miller.board_silent": "Zum Brett an der Kapelle hast du kein Wort gesagt, heißt es. Ich schweige auch über vieles.",
		"npc.miller.strangers": "Fremde sind von der Straße gekommen. Ich habe sie auf den Hof gelassen. Wer sie sind, findet selbst heraus.",
		"npc.miller.flood": "Der Fluss steigt. Noch eine Nacht, und das Wasser steht an den unteren Häusern.",
		"npc.miller.after_tell": "Jetzt ist also alles gesagt. Gut. Das Tor öffne ich niemandem mehr.",
		"npc.miller.after_keep": "Danke. Das vergesse ich nicht. Wenn ihr zum Kloster geht, helfe ich mit den Talismanen.",
		"clue.miller_book": "Im Schuppen des Müllers liegt ein Zahlungsbuch. Neben jedem Namen eine Summe, neben dem letzten nur ein Kreuz.",
		"clue.miller_sack": "Auf dem Mühlhof steht ein Sack Mehl zu viel. Den Flüchtlingen sagte der Müller, es gebe kein Mehl.",
		"clue.miller_lock": "Die Vorratskammer des Müllers ist mit einer Kette verschlossen. Drinnen kratzt etwas leise an den Brettern.",
		"sc.grave.1": "Die Erde ist frisch. Jedes Grab hier habe ich gegraben. Dieses nicht.",
		"sc.grave.1_other": "Timur ist nicht bei uns, und hinter der Mühle ist ein frisches Grab. Jemand hat ohne ihn gegraben.",
		"sc.grave.knife": "In der lockeren Erde ein Jagdmesser mit Brandzeichen. Genau so eins trägt {who}.",
		"sc.grave.stranger": "Im Grab liegt ein Fremder im Reisemantel. Niemand im Dorf kennt ihn.",
		"sc.grave.blame": "Die Fremden haben einen Toten mitgebracht. {who.cap} kam gestern, und schon das.",
		"sc.flood.1": "Über Nacht ist der Fluss um eine Elle gestiegen. Das Wasser steht schon an den unteren Häusern.",
		"sc.flood.2": "Es gibt ein Boot. Ich schaffe es zu einem Haus, wir legen Säcke vor die Schwelle. Das andere läuft voll. Wohin?",
		"sc.flood.ask": "Wohin fährt das Boot?",
		"sc.flood.c_house": "Zu: {house}",
		"sc.miller.1": "Nachts kommt der Müller selbst an deine Tür. In der Hand den Schlüssel zur Kammer.",
		"sc.miller.1_known": "Das Zahlungsbuch, der Sack zu viel, die Kette an der Kammer. Nachts klopfst du beim Müller.",
		"sc.miller.2": "Ich hatte eine Tochter. Sie ging über den Fluss. In jener Nacht erkannte ich ihre Stimme und machte auf. Sie war es nicht.",
		"sc.miller.3": "Seitdem lasse ich gegen Bezahlung rein. Das Geld geht in Kerzen für sie. Wen ich nicht reinließ, den nahm der Fluss. Hättest du nicht aufgemacht?",
		"sc.miller.ask": "Was tust du?",
		"sc.miller.c_tell": "Den Flüchtlingen erzählen",
		"sc.miller.c_keep": "Schweigen",
		"log.flood": "Wasser hat {house} überflutet. Dort schläft bis zum Kapitelende niemand, in den anderen Häusern wird es enger.",
		"night.flooded": "Überflutet",
		"ph.PLEA_FLOOD": ["Bei uns steht das Wasser. Knietief, lass mich wenigstens auf die Bank.", "{house.in} steht Wasser. Ich habe sonst nichts.", "Ich bin klatschnass, ich weiß. Lass mich rein, das Wasser steigt weiter."],
		"carry.react_revenge": "Ich habe nichts vergessen. Und werde es nicht.",
		"carry.react_accuse": "Ich habe vor allen gesagt, dass es an deiner Tür lag. Hier sage ich es wieder.",
		"carry.react_defend": "Ich habe dich verteidigt, als alle schrien. Lass es mich nicht bereuen.",
		"carry.react_withdraw": "Damals bin ich verstummt. Jetzt rede ich wieder. Nur nicht mit dir.",
		"carry.refused_died": "Wir wissen beide, wer in jener Nacht die Tür nicht geöffnet hat.",
		"carry.broken": "Mir wurde versprochen, dass die Tür aufgeht. Sie ging nicht auf. Ich habe überlebt, aber ich erinnere mich.",
		"carry.exiled_by_you": "Deine Stimme hat damals entschieden, wer gehen musste. Stimm hier vorsichtiger.",
		"carry.broke_you": "Ich habe dir etwas versprochen und es nicht gehalten. Hier halte ich es.",
		"carry.refused": "Deine Tür blieb damals zu. Ich habe überlebt. Nicht noch einmal, bitte.",
		"carry.refused_you": "Ich habe dir damals nicht geöffnet. Ich schäme mich noch heute.",
		"carry.kept": "Dein Wort an jener Tür hat gehalten. Ich erinnere mich.",
		"carry.admitted": "In jener Nacht ging deine Tür für mich auf. Hier steht meine für dich offen.",
		"carry.listened": "Ich erinnere mich an unser Gespräch am Brunnen. Kaum jemand hat zugehört.",
		"carry.letter": "Ein Brief von {who}: „{text}“",
		"carry.miller_tell": "Gut, dass die Wahrheit über den Müller rausgekommen ist. Mit dir kann man reden.",
		"carry.miller_keep": "Du weißt etwas über den Müller und schweigst. Das gefällt mir nicht.",
		"camp.act2.miller_tell": "Die Flüchtlinge kennen die Wahrheit über den Müller, und das Tor der Mühle ist hinter euch für immer zu.",
		"camp.act2.miller_keep": "Das Geheimnis des Müllers blieb bei dir, und mit ihm seine Hilfe.",
		"camp.act2.sum_few": "In zwei Akten hat das Dorf {n} verloren. Fast alle sind angekommen.",
		"camp.act2.sum_some": "In zwei Akten hat das Dorf {n} verloren. Mehr leere Plätze, als irgendwem lieb ist.",
		"camp.act2.sum_many": "In zwei Akten hat das Dorf {n} verloren. Von denen, mit denen du angefangen hast, sind wenige übrig.",
		## Группа 6 плана: книга у ворот, Игнат и Анфиса, колокол, крипта, доверие (TASK-026–030)
		"npc.ignat.name": "Bruder Ignat",
		"npc.anfisa.name": "Schwester Anfisa",
		"npc.ignat.q_book": "Das Buch am Tor zeigen",
		"npc.ignat.q_night": "Wer klopft nachts?",
		"npc.ignat.q_before": "Wer war vor uns hier?",
		"npc.ignat.a_night": "Die, die im Buch stehen, und die, die man vergessen hat einzutragen. Die zweiten klopfen lauter.",
		"npc.ignat.a_before": "Viele. Neben ihren Namen stehen jetzt Kreuze. Nicht alle Kreuze sind von mir.",
		"npc.anfisa.q_crossed": "Was ist das zweite Buch?",
		"npc.anfisa.q_heal": "Heilst du?",
		"npc.anfisa.q_night": "Was muss man nachts fürchten?",
		"npc.anfisa.a_crossed_early": "Nicht hier. Bruder Ignat sieht her. Frag mich später, wenn die Glocke läutet.",
		"npc.anfisa.a_crossed": "Das ist das Buch derer, die man hereinließ und die nicht zurückkamen. Durchgestrichen, nicht vergessen. Das Wichtigste habe ich dir ins Notizbuch geschrieben.",
		"npc.anfisa.a_heal": "Ich heile, was heilbar ist. Angst nicht. Die kann man nur aussitzen.",
		"npc.anfisa.a_night": "Stimmen, die du kennst. Fremde gibt es hier nicht.",
		"npc.ignat.open_a3c1": "Das Tor schließt bei Sonnenuntergang. Wen du ins Buch schreibst, der kommt ohne Fragen herein. Wer einen Namen einträgt, trägt dessen Sünde mit.",
		"npc.anfisa.open_a3c1": "Wenn jemand krank wird, bringt ihn zu mir ins Refektorium. Und glaubt nicht alles, was am Tor geschrieben steht.",
		"npc.ignat.open_a3c2": "Nachts läutet die Glocke von selbst. Der Schlüssel hängt an meinem Hals, der Turm ist zu. Zählt die Schläge.",
		"npc.anfisa.open_a3c2": "Die Glocke schlägt so oft, wie das Haus in der Reihe steht. Ich zähle schon lange.",
		"npc.ignat.open_a3c3": "Unter der Kirche ist eine Krypta. Wer hinabsteigt, kommt verändert herauf. Oder gar nicht.",
		"npc.anfisa.open_a3c3": "In der Krypta liegt die Antwort auf das, was du seit dem Fluss fragst. Sie wird dir nicht gefallen.",
		"npc.ignat.day1": "Wieder eine Nacht vorbei. Das Buch weiß, wer für wen gebeten hat.",
		"npc.ignat.day2": "Ich bete für alle hinter der Mauer. Und für die drinnen auch.",
		"npc.ignat.day3": "Bald geht es zur Station. Nicht alle, die ich eingetragen habe, kommen an.",
		"npc.anfisa.day1": "Letzte Nacht hat jemand hinter der Mauer geweint. Die Stimme kam mir bekannt vor. Ich habe nicht geöffnet.",
		"npc.anfisa.day2": "Die Verbände sind fast alle. Passt aufeinander auf, sonst tut es keiner.",
		"npc.ignat.vouched": "Eingetragen: {who}. Die Sünde gehört jetzt auch dir.",
		"npc.anfisa.after_trial": "Für dich sind die eingetreten, die du einst hereingelassen hast. So geht das.",
		"clue.vouch": "Im Buch am Tor: {me} hat für {who} gebürgt.",
		"clue.crossed_book": "In Anfisas zweitem Buch sind die Namen derer durchgestrichen, die man hereinließ und die nie zurückkamen. Die Tochter des Müllers steht darin und dein Name.",
		"day.p_vouch": "Ins Buch am Tor eintragen",
		"vouch.title": "Das Buch am Tor",
		"vouch.rule": "Wer hier steht, kommt nachts ohne Fragen herein. Ist es ein Werwolf, sinkt das Vertrauen des Dorfes in dich doppelt.",
		"vouch.row": "Tag {n} · {me} für {who}",
		"vouch.empty": "Noch hat niemand jemanden eingetragen.",
		"vouch.write": "Eintragen: {who}",
		"vouch.ask": "{who} ins Buch eintragen? Nachts {who:kommt er|kommt sie|kommst du} ohne Fragen zu dir herein.",
		"vouch.yes": "Eintragen",
		"vouch.sys": "Du trägst ins Buch am Tor ein: {who}.",
		"vouch.door": "Im Buch: kommt ohne Fragen herein",
		"log.trust_zero": "Das Dorf hört nicht mehr auf dich: bei der nächsten Versammlung zählt deine Stimme nicht.",
		"log.bell": "nachts schlug die Glocke {n}-mal.",
		"log.trial_exiled": "auf Bruder Ignats Wort wurde der Spieler aus dem Kloster verstoßen.",
		"mo.bell": "Nachts schlug die Glocke {n}-mal. Haus Nummer {n} in der Liste der Unterkünfte.",
		"vote.trust_mute": "Das Dorf hört heute nicht auf dich: deine Stimme zählt nicht.",
		"sc.crossed.1": "Bruder Ignat weiß nicht, dass ich es aufbewahre. Hier stehen alle, die man hereinließ und die nicht zurückkamen.",
		"sc.crossed.2": "Die Zeilen sind durchgestrichen, aber die Namen sind lesbar. Die Tochter des Müllers. Fremde Familiennamen. Und ganz unten: „{name}“.",
		"sc.crossed.2_noname": "Die Zeilen sind durchgestrichen, aber die Namen sind lesbar. Die Tochter des Müllers. Fremde Familiennamen. Und ganz unten dein Name.",
		"sc.crossed.3": "Jemand hat sie alle hereingelassen. Und alle kamen zurück, um bei denen zu klopfen, die sich an sie erinnern.",
		"sc.crossed.boat": "Das Boot brachte der, der dich vom anderen Ufer rief. Er brachte es für dich.",
		"sc.crossed.miller": "Der Müller öffnete seiner Tochter, weil er ihre Stimme erkannte. Seitdem ließ er gegen Geld herein.",
		"sc.crossed.board": "Dein Name wurde vor dreißig Jahren in das Brett an der Kapelle geritzt. Der Fluss hat dich schon einmal gesehen, nur er hat es behalten.",
		"sc.crypt.1": "Unter der Kirche ist es kalt. Die Kerze zeigt Nischen: leere Särge, auf jedem ein Name.",
		"sc.crypt.2": "In die Wand gemeißelt: Sie kommen zu denen, die sich an sie erinnern und um sie trauern, und bitten mit einer Stimme aus dieser Erinnerung um Einlass.",
		"sc.crypt.3": "Man rief dich vom anderen Ufer, weil auch um dich jemand getrauert hat.",
		"sc.crypt.ignat": "Du kamst vom anderen Ufer. Von dort kommt niemand lebend zurück. Morgen entscheiden wir, was du bist.",
		"sc.trial.open": "Dieser Mensch kam vom anderen Ufer. Sollen die sprechen, die ihn kennen. Dann entscheiden wir.",
		"sc.trial.relay": "Für {who} sprechen andere: „{text}“",
		"sc.trial.nobody": "Niemand tritt vor. Weder dafür noch dagegen.",
		"sc.trial.acquit": "Die Leute erinnern sich an mehr Gutes als Schlechtes. Lebe. Aber ich behalte dich im Auge.",
		"sc.trial.convict": "Mehr erinnern sich an Schlechtes. Geh vor Sonnenuntergang durchs Tor. So ist es entschieden.",
		"trial.def.admitted": "Dieser Mensch hat mir die Tür geöffnet, als andere es nicht taten.",
		"trial.def.kept": "Dieser Mensch hat mir etwas versprochen und Wort gehalten. Werwölfe halten kein Wort.",
		"trial.def.listened": "Dieser Mensch hat mir zugehört, als es mir am schlechtesten ging.",
		"trial.def.react_defend": "Ich bin damals für diesen Menschen eingetreten und tue es jetzt wieder.",
		"trial.def.refused_you": "Ich habe diesem Menschen nicht geöffnet, und er hat es mir nie vorgeworfen.",
		"trial.acc.refused_died": "Dieser Mensch hat nicht geöffnet, und vor der Tür ist jemand gestorben.",
		"trial.acc.refused": "Dieser Mensch hat mich draußen gelassen. Ich erinnere mich an jede Minute dieser Nacht.",
		"trial.acc.broken": "Dieser Mensch hat versprochen zu öffnen. Er hat es nicht getan.",
		"trial.acc.exiled_by_you": "Die Stimme dieses Menschen hat einen Unschuldigen vertrieben.",
		"trial.acc.react_accuse": "Ich habe es vor allen gesagt: das Unglück kam durch seine Tür.",
		"trial.acc.react_revenge": "Ich habe nichts zu sagen. Entscheidet selbst. Ich habe längst entschieden.",
		"camp.act3.end_trial": "Das Klostertor schließt sich hinter dir. Die anderen gehen ohne dich zur Station. Du hörst, wie jemand dich vom anderen Ufer ruft.",
		"trial.def.broke_you": "Ich habe diesen Menschen betrogen, und er hat mich nicht verraten.",
		"npc.anfisa.day3": "Ich sehe, wie du zum Tor schaust. Geh nachts nicht hin.",
		"vouch.done_today": "Heute steht schon ein Name im Buch. Morgen geht noch einer.",
		"camp.act3.trial_won": "Das Gericht in der Krypta ging zu deinen Gunsten aus, dank derer, die sich an deine Türen erinnern.",
		## Группа 7 плана: станция, люди станции, список, последний поезд, финал (TASK-031–035)
		"npc.keeper.name": "Bahnhofsvorsteher",
		"npc.keeper.q_list": "Die Liste für den Zug",
		"npc.keeper.q_train": "Wann kommt der Zug?",
		"npc.keeper.q_night": "Wer klopft nachts?",
		"npc.keeper.a_list_early": "Die Liste kommt kurz vor dem Zug. Schreiben wird sie der Schreiber, nicht ich. Behaltet ihn im Auge.",
		"npc.keeper.a_list_list": "Die Liste habe ich. Sieh selbst.",
		"npc.keeper.a_train": "Der Telegraf schweigt seit drei Tagen. Den Schlüssel habe ich, aber antworten tut keiner. Der Zug kommt. Die Frage ist, mit wem.",
		"npc.keeper.a_night": "Nachts gehen auf den Gleisen die, die den Zug nicht erlebt haben. Sie wissen, dass es wenig Plätze gibt.",
		"npc.keeper.open_a4c1": "Das ist die letzte Station. Danach kein Wald mehr, nur Gleise. Der Zug soll in vier Nächten kommen.",
		"npc.keeper.open_a4c2": "Wir beginnen die Liste. Es gibt weniger Plätze als euch. Der Schreiber schreibt, ich schaue zu.",
		"npc.keeper.open_a4c3": "Der Zug ist nah. Weniger Plätze als Menschen auf dem Bahnsteig. Tragt jeden Tag einen Namen ein. Und traut den Unterschriften nicht.",
		"st.worker.open": "Die Lok mache ich wieder flott. Ich muss nur erleben, dass sie losfährt.",
		"st.clerk.open": "Zehn Plätze. Ihr seid vierzehn auf der Station. Kannst du rechnen?",
		"st.struck": "Man hat mich von der Liste gestrichen. Mit deiner Hand. Das merke ich mir.",
		"st.struck_door": "Ich habe dir die Tür geöffnet. Und du streichst mich von der Liste.",
		"st.covered": "Danke. Das vergesse ich nicht. Wirklich nicht.",
		"guest.worker.name": "Stefan",
		"guest.worker.title": "Arbeiter im Depot, {n}. Repariert die Lok",
		"guest.worker.story": "Zwanzig Jahre im Depot. Kennt jede Schraube der Lok auf dem Abstellgleis. Sagt, die Maschine fährt, wenn man sie nicht aufgibt.",
		"guest.worker.clue1": "Nachts hörte man Hämmern aus dem Depot. Am Morgen sagte {who}, er habe geschlafen und nichts gehört.",
		"guest.worker.clue2": "In der Werkzeugkiste von {who} liegt ein Stück fremder Riemen. Er sagt, er habe es auf den Gleisen gefunden.",
		"guest.worker.reveal_h": "{who} reparierte die Lok nachts, um vor dem Zug fertig zu werden. Den Riemen nahm er einem toten Heizer ab, um einen gerissenen zu ersetzen.",
		"guest.worker.reveal_u": "Die Lok hat {who} nie repariert. In der Feuerbüchse fand man Kleiderfetzen derer, die zum Depot gingen und nicht zurückkamen.",
		"guest.clerk.name": "Arnold",
		"guest.clerk.title": "Schreiber, {n}. Schreibt die Liste für den Zug",
		"guest.clerk.story": "Diente in der Kreisverwaltung. Saubere Handschrift, höfliches Lächeln. Er schreibt die Liste, weil sonst keiner so schnell schreiben kann.",
		"guest.clerk.clue1": "In der Tasche von {who} klimpert es. Am Morgen kaufte er beim Vorsteher Petroleum und zahlte mit Silber.",
		"guest.clerk.clue2": "Im Entwurf der Liste von {who} stehen neben manchen Namen Zahlen. Er sagt, das seien Wagennummern.",
		"guest.clerk.reveal_h": "{who} nahm Geld für Plätze auf der Liste. Wer zahlte, stand weiter oben. Er ist kein Werwolf: er hat nur die Rettung verkauft.",
		"guest.clerk.reveal_u": "{who} nahm für die Plätze kein Geld. Wer ihn bezahlte, kam nachts nicht vom Bahnsteig zurück.",
		"clue.train": "Auf der Liste für den Zug: {me} hat {who} eingetragen.",
		"day.p_list_write": "Auf die Zugliste schreiben",
		"day.p_list_strike": "Von der Liste streichen",
		"list.title": "Liste für den Zug · Plätze: {n}",
		"list.rule": "Pro Tag kannst du einen Namen eintragen und einen streichen. Gestrichene kommen nicht zurück. Ein Werwolf auf der Liste fährt mit allen mit.",
		"list.row": "{who} · eingetragen von {me}",
		"list.row_secret": "{who} · Unterschrift unleserlich",
		"list.empty": "Die Liste ist noch leer.",
		"list.write": "Eintragen: {who}",
		"list.strike": "Streichen: {who}",
		"list.sys_write": "Du trägst auf die Zugliste ein: {who}.",
		"list.sys_strike": "Du streichst von der Liste: {who}.",
		"list.cant": "Heute nicht mehr: die Liste ist voll oder du hast das heute schon getan.",
		"sc.betray.1": "Morgen auf dem Bahnsteig. Nebel liegt auf den Gleisen. Der Vorsteher hält die Liste und starrt lange auf eine Zeile.",
		"sc.betray.2": "Diese Zeile wurde nachts geschrieben. Die Handschrift kenne ich. Sie ist von {who}.",
		"sc.betray.human": "Ich wollte den Zug erleben. Ich habe den eingetragen, vor dem ich Angst hatte, damit er mich nicht anrührt. An meiner Stelle hätte das jeder getan.",
		"sc.betray.upyr": "Den ganzen Weg war ich dein Freund. Das war nicht schwer. Ich brauchte nur einen Platz im Wagen.",
		"sc.betray.clerk": "Man hat mich bezahlt. Ich bin Schreiber, ich schreibe, wofür man zahlt. Wer zahlt, ist mir gleich.",
		"sc.betray.ask": "Was sagst du über {who}?",
		"sc.betray.c_expose": "Allen erzählen",
		"sc.betray.c_cover": "Decken",
		"sc.final.1": "Die letzte Nacht vor dem Zug. Die Station schläft. Dreimal klopft es an die Tür, wie in der ersten Nacht.",
		"sc.final.voice": "Ich bin es, {who}. Mach auf. Ich habe die ganze Zeit am anderen Ufer auf dich gewartet.",
		"sc.final.voice_self": "Hinter der Tür ruft dich deine eigene Stimme beim Namen. Die, die ins Brett an der Kapelle geritzt ist.",
		"sc.final.2": "In der Ferne pfeift ein Zug. Vor dem Morgengrauen ist er am Bahnsteig.",
		"sc.act2.1": "Herbst. Ihr watet zur Mühle und tragt eure Sachen über dem Kopf. Das Rad dreht sich ins Leere: Seit Langem bringt niemand mehr Korn.",
		"sc.act2.2": "Der Müller wartet mit einer Laterne auf den Bohlen und zählt euch durch. Er zählt zweimal.",
		"sc.act2.3": "Am Ufer sind fremde Spuren. Sie führen zum Wasser und kehren nicht zurück.",
		"sc.act2.end": "Das Rad bleibt stehen. Zum ersten Mal seit Tagen hört man nur den Fluss.",
		"sc.act3.1": "Der Winter kam vor dem Weg. Ihr stapft knietief im Schnee zum Kloster und sprecht kaum.",
		"sc.act3.2": "Auf der Mauer brennt eine einzige Laterne. Darunter steht ein Mönch und rührt sich nicht, bis ihr dicht vor ihm steht.",
		"sc.act3.3": "Über euren Köpfen schweigt die Glocke. Bruder Ignat sagt, so sei es besser.",
		"sc.act3.end": "Das Buch ist geschlossen. Die Namen bleiben darin, wo sie geschrieben wurden.",
		"sc.act4.1": "Frühling. Der Schnee ist weg, und auf dem Damm sieht man die Schienen. Sie glänzen, als wäre gestern jemand darauf gegangen.",
		"sc.act4.2": "Der Bahnsteig versinkt im Nebel. Der Bahnhofsvorsteher wartet an der einzigen Laterne und fragt nicht, woher ihr kommt.",
		"sc.act4.3": "Im Fahrplan an der Wand steht ein einziger Zug. Das Datum ist abgerieben.",
		"sc.lights.1": "Gegen Morgen legt sich der Nebel auf die Gleise. Weit darin gehen zwei gelbe Lichter an.",
		"sc.lights.2": "Kein Pfiff. Die Lichter bleiben stehen und erlöschen dann eins nach dem anderen.",
		"sc.lights.3": "Der Bahnhofsvorsteher sagt, das sei nicht der Zug. Der Zug ist noch nicht gekommen.",
		"sc.train.1": "Du öffnest nicht. Das Klopfen wird schwächer und hört auf. Bis zum Morgen bleibt nur das Warten.",
		"sc.train.2": "Im Morgengrauen fährt der Zug ein. Die Wagentüren öffnen sich von selbst.",
		"sc.shore.1": "Du schiebst den Riegel zurück. Draußen ist es heller, als es in einer solchen Nacht sein dürfte.",
		"sc.shore.2": "Auf der anderen Seite wartet jemand. Du trittst über die Schwelle.",
		"sc.final.ask": "Was tust du?",
		"sc.final.c_open": "Öffnen und gehen",
		"sc.final.c_train": "Nicht öffnen, auf den Zug warten",
		"fin.btn": "Die letzte Nacht",
		"fin.final_shore": "Du öffnest. Auf der Schwelle steht, wer vor allen anderen verloren ging. Die Tür schließt sich hinter euch. Am Morgen fährt der Zug ohne dich, und deine Spuren auf dem Bahnsteig führen zum Fluss.",
		"fin.final_upyr": "Der Zug fährt im Morgengrauen. Im Wagen ist es eng und still. Ab der dritten Station kommt aus dem letzten Abteil niemand mehr heraus. Der Werwolf von der Liste fährt mit euch.",
		"fin.final_many": "Der Zug fährt im Morgengrauen. Fast alle, die das Dorf verlassen haben, sitzen im Wagen. Der Wald draußen endet, und niemand klopft mehr.",
		"fin.final_few": "Der Zug fährt im Morgengrauen. Im Wagen sind viele Plätze leer. Du weißt noch, wer darauf sitzen sollte.",
