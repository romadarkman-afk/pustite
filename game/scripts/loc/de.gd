extends Gram
## Deutsch. Ein Dorf aus den Märchen: Hänsel und Gretel, ein Mädchen mit roter Kappe,
## der Wolf Isegrim, der Fuchs Reineke, Till mit der Narrenkappe, der Struwwelpeter.
## Das Ungeheuer heißt hier Werwolf. Namen werden nicht dekliniert, {who.pos} gibt „Gretels".


func code() -> String:
	return "de"


func name_case(name: String, case: String, _female: bool) -> String:
	if case == "pos":
		return name + ("'" if name.right(1) in ["s", "ß", "x", "z"] else "s")
	return name


