extends Gram
## Français. Un village de romans et de contes : Aramis le mousquetaire, Cyrano et son nez,
## Gavroche, Cosette, Marianne au bonnet rouge, le coq Coco et le chat Mistigri en bottes.
## Le monstre s'appelle ici loup-garou. {who.de} donne « de Cosette » ou « d'Aramis ».


func code() -> String:
	return "fr"


func _vowel(name: String) -> bool:
	return "aeiouyhàâéèêëîïôûAEIOUYHÀÂÉÈÊÎÔÛ".contains(name.left(1))


func name_case(name: String, case: String, _female: bool) -> String:
	match case:
		"de":
			return ("d'" if _vowel(name) else "de ") + name
		"a":
			return "à " + name
	return name


func plural_index(n: int) -> int:
	return 0 if absi(n) <= 1 else 1


