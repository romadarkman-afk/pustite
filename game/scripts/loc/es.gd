extends Gram
## Español (México y Latinoamérica). Un pueblo de leyendas: don Alonso con su lanza y Sancho,
## la Catrina de sombrero con flores, la Adelita con trenzas, un luchador enmascarado y el jaguar Balam.
## El monstruo es el vampiro. {who.a} da «a Rosa» (a personal).


func code() -> String:
	return "es"


func name_case(name: String, case: String, _female: bool) -> String:
	if case == "a":
		return "a " + name
	return name


