extends Gram
## Русский. Падежи имён и домов, числительные «1 житель, 2 жителя, 5 жителей».
## Игрок в третьем лице — «Вы»: пол игрока игра не знает, вежливое «вы» снимает вопрос.


func code() -> String:
	return "ru"


## 1 житель, 2 жителя, 5 жителей, 21 житель.
func plural_index(n: int) -> int:
	var n10 := absi(n) % 10
	var n100 := absi(n) % 100
	if n10 == 1 and n100 != 11:
		return 0
	if n10 >= 2 and n10 <= 4 and (n100 < 12 or n100 > 14):
		return 1
	return 2


## acc: Марина → Марину, Тимур → Тимура. gen: Марины, Гриши, Жени. dat: Марине, Тимуру.
## ins: Мариной, Гришей, Тимуром.
func name_case(name: String, case: String, _female: bool) -> String:
	if name.is_empty():
		return name
	var stem := name.substr(0, name.length() - 1)
	var last := name.right(1)
	match case:
		"acc":
			match last:
				"а": return stem + "у"
				"я": return stem + "ю"
				"й", "ь": return stem + "я"
			return name + "а"
		"gen":
			match last:
				"а": return stem + ("и" if "гкхжшчщ".contains(stem.right(1)) else "ы")
				"я": return stem + "и"
				"й", "ь": return stem + "я"
			return name + "а"
		"dat":
			match last:
				"а", "я": return stem + "е"
				"й", "ь": return stem + "ю"
			return name + "у"
		"ins":
			var soft := "жшчщц".contains(stem.right(1))
			match last:
				"а": return stem + ("ей" if soft else "ой")
				"я": return stem + "ей"
				"й", "ь": return stem + "ем"
			return name + ("ем" if "жшчщц".contains(last) else "ом")
	return name


