		"sc.river.1": "Dusk. The road ends at a river. Beyond it there's only the ferry.",
		"sc.river.voice": "From the other bank",
		"sc.river.2": "\"{name}!\"",
		"sc.river.3": "Don't answer. It remembers voices.",
		"sc.river.ask": "The voice calls again.",
		"sc.river.c_silent": "Stay silent",
		"sc.river.c_answer": "Answer",
		"sc.river.4": "The ferry keeper puts out her lantern. You walk to the village in silence.",
		"sc.river.4b": "Someone laughs on the other bank. The ferry keeper puts out her lantern and won't look at you again.",
		"sc.river.5": "Night. Someone is knocking.",
		"sc.river.answered": "I asked you not to answer the other bank. Now it knows your voice.",
		"sc.m1.admit.1": "Morning. {who} is asleep by the stove under your coat.",
		"sc.m1.admit.2": "I won't forget who opened the door for me last night.",
		"sc.m1.close.1": "Before dawn a floorboard creaks. Someone is standing by your bench.",
		"sc.m1.close.2": "A neighbor coughs behind the wall. The footsteps move back to the stove.",
		"sc.m1.close.3": "In the morning {who} says they never got up in the night.",
		"sc.m1.refuse.1": "Tracks in the snow by the door. Someone stood on the step for a long time.",
		"sc.m1.refuse.2": "I knocked. The door never opened. I'll remember.",
		"sc.m1.refuse.3": "The tracks end at the road. {who} didn't come back.",
		"door.ask": "Who's there?",
		"door.ask_true": "\"It's {me}. I said during the day I'd sleep in {house.in}.\"",
		"door.ask_changed": "\"It's {me}. Where I meant to go is already full.\"",
		"door.ask_vague": "\"Open up, I'll explain later. It's cold.\"",
		"door.ask_choice": "What will you ask?",
		"door.ask_choice_who": "Ask who is there",
