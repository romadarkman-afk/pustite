		"memo.broken": "{who} remembers a promise broken.",
		"memo.refused": "{who} remembers a shut door.",
		"memo.refused_died": "{who} knocked at your door and didn't live to see morning. The others remember.",
		"memo.refused_you": "{who} remembers not opening for you.",
		"memo.broke_you": "{who} remembers breaking a promise to you.",
		"memo.exiled_by_you": "Your vote sent {who} away. The village remembers.",
		"memo.react_accuse": "{who} blamed your door in front of everyone.",
		"memo.react_defend": "{who} stood up for you after the loss.",
