extends Gram
## Türkçe. Masallardan bir köy: kavuklu Nasreddin Hoca, kel Keloğlan, gölge oyunundan Karagöz ile Hacivat,
## fesli Mehmet ve sokak kedisi Pamuk. Canavar burada hortlak. Kadın-erkek ayrımı yok;
## özel isimlere ek kesme işaretiyle gelir: Ayşe'yi, Mehmet'in, Pamuk'a.


func code() -> String:
	return "tr"


const _BACK := "aıou"
const _VOWELS := "aıoueiöü"
const _HARD := "fstkçşhp"


func _last_vowel(w: String) -> String:
	var low := w.to_lower()
	for i in range(low.length() - 1, -1, -1):
		var c := low.substr(i, 1)
		if _VOWELS.contains(c):
			return c
	return "e"


## İki yollu: a / e.
func _h2(w: String) -> String:
	return "a" if _BACK.contains(_last_vowel(w)) else "e"


## Dört yollu: ı / i / u / ü.
func _h4(w: String) -> String:
	match _last_vowel(w):
		"a", "ı": return "ı"
		"e", "i": return "i"
		"o", "u": return "u"
	return "ü"


func name_case(name: String, case: String, _female: bool) -> String:
	if name.is_empty():
		return name
	var last := name.right(1).to_lower()
	var vow := _VOWELS.contains(last)
	var d := "t" if _HARD.contains(last) else "d"
	match case:
		"acc": return name + "'" + ("y" if vow else "") + _h4(name)
		"gen": return name + "'" + ("n" if vow else "") + _h4(name) + "n"
		"dat": return name + "'" + ("y" if vow else "") + _h2(name)
		"loc": return name + "'" + d + _h2(name)
		"abl": return name + "'" + d + _h2(name) + "n"
		"ins": return name + "'" + ("y" if vow else "") + "l" + _h2(name)
	return name


func plural_index(_n: int) -> int:
	return 0


