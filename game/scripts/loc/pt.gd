## a baiana de turbante, um cangaceiro de chapéu de couro e a arara Juca.
## O monstro é o lobisomem. O jogador é «você»: verbos na terceira pessoa.


func code() -> String:
	return "pt"


func plural_index(n: int) -> int:
	return 0 if absi(n) <= 1 else 1


