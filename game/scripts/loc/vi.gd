		"sc.board.3": "Ba mươi năm trước đã có người mang tên này ở đây. Nói thật đi: là bạn sao?",
		"sc.board.alone": "Ở nhà nguyện không có ai. Dưới tấm bảng có vụn gỗ mới: ai đó đã làm sạch dòng cuối.",
		"sc.board.ask": "Bạn trả lời thế nào?",
		"sc.board.c_confess": "“Đó là tên tôi. Tôi nhớ con sông này.”",
		"sc.board.c_deny": "“Trùng hợp thôi. Tên này phổ biến.”",
		"sc.board.c_silent": "Im lặng",
		"sc.board.r_confess": "Vậy là con sông đã thả bạn đi, giờ lại gọi bạn về. Tôi sẽ không kể với ai. Tạm thời.",
		"sc.board.r_deny": "Được, trùng hợp. Nghĩ vậy tôi yên tâm hơn.",
		"sc.board.r_silent": "Bạn im lặng. Vậy tôi sẽ tự hiểu điều đó nghĩa là gì.",
		"day.p_send": "Đưa sang sông bằng thuyền",
		"day.send_ask": "Rạng sáng {who} sẽ qua sông và không trở lại trong chương này. Nếu dòng sông chịu đưa. Đưa đi?",
		"day.send_yes": "Đưa đi",
		"sys.send": "Rạng sáng {who} sẽ qua sông.",
		"log.sent": "{who.cap} đã qua sông.",
		"log.sent_back": "{who.cap} đã quay lại: thuyền tự quay đầu giữa sông.",
		"mo.sent": "{who.cap} đi lúc rạng sáng. Thuyền đã nằm ở bờ bên kia, trống không.",
		"mo.sent_back": "{who.cap} lại đứng ở bến: thuyền tự quay đầu giữa sông. Dòng sông không đưa ai cũng được.",
		"farewell.warm": "Cảm ơn. Nếu tôi về, tôi sẽ gõ ba lần.",
		"farewell.cold": "Bạn muốn tống khứ tôi. Được, tôi đi.",
		"rev.boat_answer.title": "Ai đưa thuyền về",
		"rev.boat_answer.text": "{who} nhìn mặt nước rất lâu: “Không ai lấy trộm thuyền. Kẻ gọi bạn từ bờ bên kia cứ đưa nó về. Hắn chờ ai đó ở đây bước lên. Hắn vẫn đang chờ.”",
		"rev.boat_answer.item": "Mái chèo, chiếc khăn và dấu chân ở bến khớp với nhau: thuyền đến từ bờ bên kia. Kẻ gọi tên bạn vẫn đang chờ.",
		"camp.act1.boat": "Bí ẩn chiếc thuyền trống đã sáng tỏ: nó được đưa từ bờ bên kia.",
		"camp.act1.boat_open": "Ai đưa chiếc thuyền trống về vẫn chưa ai biết.",
		"camp.act1.board_confess": "Cái tên trên tấm bảng giờ là của bạn, và cả làng biết điều đó.",
		"camp.act1.board_deny": "Cái tên trên tấm bảng vẫn là của người khác. Tạm thời.",
		"camp.act1.board_silent": "Cái tên trên tấm bảng vẫn chưa có lời đáp.",
		## Группа 5 плана: мельник, его тайна, чужаки, половодье, память акта I (TASK-021–025)
		"npc.miller.name": "Ông chủ cối xay Saveli",
		"npc.line": "{name}: “{text}”",
		"npc.busy": "{name} đã trả lời hôm nay rồi. Mai hãy hỏi.",
		"npc.miller.q_ford": "Chỗ lội qua sông thế nào?",
		"npc.miller.q_before": "Ai ở đây trước chúng tôi?",
		"npc.miller.q_night": "Ai gõ cửa ban đêm?",
		"npc.miller.a_ford": "Nước cạn, ngang gối. Nhưng ban đêm thứ lội qua đó không phải người. Khóa cửa lại.",
		"npc.miller.a_before": "Dân chạy nạn. Ở một thời gian rồi đi ngược dòng. Chắc không phải ai cũng tới nơi.",
		"npc.miller.a_before_known": "Có người xem sổ của tôi rồi, tôi thấy. Phải, họ trả tiền. Ai trả thì được vào. Đừng hỏi thêm.",
		"npc.miller.a_night": "Không ai sang từ bờ bên kia, ban đêm nước giữ chỗ lội. Chỉ người của mình gõ cửa. Hoặc kẻ giả làm người của mình.",
		"npc.miller.rule": "Tôi chỉ có một luật: ban đêm chỗ lội đóng, chỉ gõ cửa từ bờ này. Không quen thì đừng cho vào.",
		"npc.miller.board_confess": "Nghe nói tên bạn khắc trên tấm bảng nhà nguyện. Vậy bạn từ đó tới. Tôi sẽ nhớ.",
		"npc.miller.board_deny": "Người ta kể tôi nghe về tấm bảng nhà nguyện. Nghe nói bạn cho là trùng hợp. Ừ.",
		"npc.miller.board_silent": "Nghe nói về tấm bảng nhà nguyện bạn không nói một lời. Tôi cũng im lặng về nhiều chuyện.",
		"npc.miller.strangers": "Có người lạ từ đường cái tới. Tôi cho họ vào sân. Họ là ai, tự các người tìm hiểu.",
		"npc.miller.flood": "Sông đang lên. Thêm một đêm nữa là nước tới các nhà thấp.",
		"npc.miller.after_tell": "Vậy là mọi chuyện đã nói ra. Thôi được. Tôi không mở cổng cho ai nữa.",
		"npc.miller.after_keep": "Cảm ơn. Tôi sẽ không quên. Khi các người đi tới tu viện, tôi sẽ giúp với bùa hộ mệnh.",
		"clue.miller_book": "Trong nhà kho của ông chủ cối xay có sổ thu tiền. Cạnh mỗi tên là một khoản, cạnh tên cuối chỉ có dấu thập.",
		"clue.miller_sack": "Trong sân cối xay thừa một bao bột. Ông chủ cối xay từng nói với dân chạy nạn là hết bột.",
		"clue.miller_lock": "Kho của ông chủ cối xay bị khóa xích. Bên trong có thứ gì đó cào khẽ vào ván.",
		"sc.grave.1": "Đất còn mới. Mọi ngôi mộ ở đây đều do tôi đào. Cái này thì không.",
		"sc.grave.1_other": "Timur không ở với chúng ta, mà sau cối xay có một ngôi mộ mới. Ai đó đã đào mà không có anh ấy.",
		"sc.grave.knife": "Trong đất tơi có một con dao săn đóng dấu. {who} mang đúng loại như vậy.",
		"sc.grave.stranger": "Dưới mộ là một người lạ mặc áo choàng đi đường. Trong làng không ai biết người này.",
		"sc.grave.blame": "Bọn người lạ mang theo một xác chết. {who.cap} mới tới hôm qua, giờ thì thế này.",
		"sc.flood.1": "Qua đêm nước sông lên một gang. Nước đã tới các nhà thấp.",
		"sc.flood.2": "Chỉ có một chiếc thuyền. Tôi kịp đưa tới một nhà, chặn bao cát trước ngưỡng cửa. Nhà kia sẽ ngập. Đưa đi đâu?",
		"sc.flood.ask": "Thuyền đi đâu?",
		"sc.flood.c_house": "Tới: {house}",
		"sc.miller.1": "Ban đêm chính ông chủ cối xay tới gõ cửa nhà bạn. Tay cầm chìa khóa kho.",
		"sc.miller.1_known": "Sổ thu tiền, bao bột thừa, sợi xích ở kho. Ban đêm bạn tới gõ cửa nhà ông chủ cối xay.",
		"sc.miller.2": "Tôi từng có một đứa con gái. Nó đã qua sông. Đêm đó tôi nhận ra giọng nó và mở cửa. Đó không phải nó.",
		"sc.miller.3": "Từ đó tôi cho vào nếu trả tiền. Tiền dùng mua nến cho nó. Ai tôi không cho vào thì sông mang đi. Bạn sẽ không mở sao?",
		"sc.miller.ask": "Bạn làm gì?",
		"sc.miller.c_tell": "Kể cho dân chạy nạn",
		"sc.miller.c_keep": "Im lặng",
		"log.flood": "Nước đã ngập {house}. Tới hết chương không ai ngủ ở đó, các nhà khác chật hơn.",
		"night.flooded": "Bị ngập",
		"ph.PLEA_FLOOD": ["Nhà tôi ngập rồi. Nước ngang gối, cho tôi ngồi tạm cái ghế thôi.", "{house.in} ngập nước. Tôi không còn chỗ nào khác.", "Tôi ướt sũng, tôi biết. Cho tôi vào, nước vẫn đang lên."],
		"carry.react_revenge": "Tôi không quên gì cả. Và sẽ không quên.",
		"carry.react_accuse": "Tôi đã nói trước mọi người rằng vì cánh cửa của bạn. Ở đây tôi nói lại.",
		"carry.react_defend": "Tôi đã bênh bạn khi mọi người la hét. Đừng để tôi hối hận.",
		"carry.react_withdraw": "Hồi đó tôi im lặng. Giờ tôi nói lại rồi. Chỉ là không với bạn.",
		"carry.refused_died": "Cả hai ta đều nhớ đêm đó ai đã không mở cửa.",
		"carry.broken": "Người ta hứa với tôi cửa sẽ mở. Nó không mở. Tôi sống sót, nhưng tôi nhớ.",
		"carry.exiled_by_you": "Hồi đó lá phiếu của bạn quyết định ai bị đuổi. Ở đây bỏ phiếu cẩn thận.",
		"carry.broke_you": "Tôi đã hứa với bạn mà không giữ lời. Ở đây tôi sẽ giữ.",
		"carry.refused": "Hồi đó cửa nhà bạn vẫn đóng. Tôi sống sót. Đừng như vậy nữa.",
		"carry.refused_you": "Hồi đó tôi không mở cửa cho bạn. Tới giờ tôi vẫn xấu hổ.",
		"carry.kept": "Lời bạn ở cánh cửa đó đã giữ được. Tôi nhớ.",
		"carry.admitted": "Đêm đó cửa nhà bạn mở cho tôi. Ở đây cửa nhà tôi mở cho bạn.",
		"carry.listened": "Tôi nhớ cuộc nói chuyện bên giếng. Hồi đó hầu như không ai chịu nghe.",
		"carry.letter": "Thư của {who}: “{text}”",
		"carry.miller_tell": "May là sự thật về ông chủ cối xay đã lộ ra. Bạn là người đáng tin.",
		"carry.miller_keep": "Bạn biết gì đó về ông chủ cối xay mà im lặng. Tôi không thích vậy.",
		"camp.act2.miller_tell": "Dân chạy nạn biết sự thật về ông chủ cối xay, và cổng cối xay đã đóng lại sau lưng các bạn mãi mãi.",
		"camp.act2.miller_keep": "Bí mật của ông chủ cối xay ở lại với bạn, cùng với sự giúp đỡ của ông.",
		"camp.act2.sum_few": "Qua hai hồi làng mất {n} người. Gần như ai cũng tới nơi.",
		"camp.act2.sum_some": "Qua hai hồi làng mất {n} người. Chỗ trống trong hàng nhiều hơn ai mong muốn.",
		"camp.act2.sum_many": "Qua hai hồi làng mất {n} người. Những người bắt đầu cùng bạn chỉ còn ít.",
		## Группа 6 плана: книга у ворот, Игнат и Анфиса, колокол, крипта, доверие (TASK-026–030)
		"npc.ignat.name": "Thầy Ignat",
		"npc.anfisa.name": "Sơ Anfisa",
		"npc.ignat.q_book": "Cho xem sổ ở cổng",
		"npc.ignat.q_night": "Ai gõ cửa ban đêm?",
		"npc.ignat.q_before": "Ai ở đây trước chúng tôi?",
		"npc.ignat.a_night": "Những người có tên trong sổ, và những người bị quên ghi. Bọn sau gõ mạnh hơn.",
		"npc.ignat.a_before": "Nhiều lắm. Giờ cạnh tên họ có dấu thập. Không phải dấu nào cũng do tôi đánh.",
		"npc.anfisa.q_crossed": "Cuốn sổ thứ hai là gì?",
		"npc.anfisa.q_heal": "Sơ có chữa bệnh không?",
		"npc.anfisa.q_night": "Ban đêm nên sợ điều gì?",
		"npc.anfisa.a_crossed_early": "Không phải ở đây. Thầy Ignat đang nhìn. Hãy hỏi tôi sau, khi chuông kêu.",
		"npc.anfisa.a_crossed": "Đây là sổ của những người được cho vào rồi không trở về. Bị gạch tên nhưng không bị quên. Tôi đã chép điều quan trọng vào sổ của bạn.",
		"npc.anfisa.a_heal": "Tôi chữa những gì chữa được. Nỗi sợ thì không. Chỉ có thể chờ nó qua.",
		"npc.anfisa.a_night": "Những giọng nói bạn quen. Ở đây không có người lạ.",
		"npc.ignat.open_a3c1": "Cổng đóng lúc mặt trời lặn. Ai được bạn ghi vào sổ sẽ được vào không cần hỏi. Đã ghi tên ai thì tội của người đó giờ cũng là của bạn.",
		"npc.anfisa.open_a3c1": "Nếu ai ốm, hãy đưa tới phòng ăn cho tôi. Và đừng tin mọi thứ ghi ở cổng.",
		"npc.ignat.open_a3c2": "Ban đêm chuông tự kêu. Chìa khóa đeo ở cổ tôi, tháp chuông khóa kín. Hãy đếm số tiếng.",
		"npc.anfisa.open_a3c2": "Chuông đánh bao nhiêu tiếng thì là nhà số bấy nhiêu. Tôi đếm lâu rồi.",
		"npc.ignat.open_a3c3": "Dưới nhà thờ có hầm mộ. Ai xuống đó sẽ lên khác đi. Hoặc không lên nữa.",
		"npc.anfisa.open_a3c3": "Trong hầm mộ có câu trả lời cho điều bạn hỏi từ bên sông. Bạn sẽ không thích đâu.",
		"npc.ignat.day1": "Thêm một đêm nữa đã qua. Cuốn sổ nhớ ai đã xin cho ai.",
		"npc.ignat.day2": "Tôi cầu nguyện cho mọi người bên kia tường. Cho cả người bên trong.",
		"npc.ignat.day3": "Sắp tới đường lên ga. Không phải ai tôi ghi tên cũng tới nơi.",
		"npc.anfisa.day1": "Đêm qua có người khóc bên kia tường. Giọng nghe quen. Tôi không mở.",
		"npc.anfisa.day2": "Băng gạc gần hết. Hãy giữ gìn nhau, không còn ai khác đâu.",
		"npc.ignat.vouched": "Đã ghi: {who}. Tội của người đó giờ cũng là của bạn.",
		"npc.anfisa.after_trial": "Những người bạn từng cho vào đã bênh bạn. Mọi chuyện là như vậy.",
		"clue.vouch": "Trong sổ ở cổng: {me} đã bảo lãnh cho {who}.",
		"clue.crossed_book": "Trong cuốn sổ thứ hai của Anfisa, tên những người được cho vào rồi không trở về đều bị gạch. Có con gái ông chủ cối xay, và có cả tên bạn.",
		"day.p_vouch": "Ghi vào sổ ở cổng",
		"vouch.title": "Sổ ở cổng",
		"vouch.rule": "Ai có tên ở đây sẽ được vào ban đêm không cần hỏi. Nếu đó là ma cà rồng, lòng tin của làng với bạn giảm gấp đôi.",
		"vouch.row": "ngày {n} · {me} cho {who}",
		"vouch.empty": "Chưa ai ghi tên ai.",
		"vouch.write": "Ghi: {who}",
		"vouch.ask": "Ghi {who} vào sổ? Ban đêm người đó sẽ vào nhà bạn không cần hỏi.",
		"vouch.yes": "Ghi",
		"vouch.sys": "Bạn ghi vào sổ ở cổng: {who}.",
		"vouch.door": "Có tên trong sổ: vào không cần hỏi",
		"log.trust_zero": "Làng không còn nghe bạn: ở buổi họp tới phiếu của bạn không được tính.",
		"log.bell": "ban đêm chuông đánh {n} tiếng.",
		"log.trial_exiled": "theo lời thầy Ignat, người chơi bị đuổi khỏi tu viện.",
		"mo.bell": "Ban đêm chuông đánh {n} tiếng. Nhà số {n} trong danh sách chỗ trú.",
		"vote.trust_mute": "Hôm nay làng không nghe bạn: phiếu của bạn không được tính.",
		"sc.crossed.1": "Thầy Ignat không biết tôi giữ nó. Ở đây có tất cả những người được cho vào rồi không trở về.",
		"sc.crossed.2": "Các dòng bị gạch, nhưng vẫn đọc được tên. Con gái ông chủ cối xay. Những cái họ lạ. Và tận cuối: “{name}”.",
		"sc.crossed.2_noname": "Các dòng bị gạch, nhưng vẫn đọc được tên. Con gái ông chủ cối xay. Những cái họ lạ. Và tận cuối là tên bạn.",
		"sc.crossed.3": "Có ai đó đã cho tất cả họ vào. Và tất cả quay lại gõ cửa những người còn nhớ họ.",
		"sc.crossed.boat": "Chiếc thuyền do kẻ gọi bạn từ bờ bên kia đưa tới. Hắn đưa nó tới vì bạn.",
		"sc.crossed.miller": "Ông chủ cối xay mở cửa cho con gái vì nhận ra giọng nó. Từ đó ông cho vào nếu trả tiền.",
		"sc.crossed.board": "Tên bạn được khắc lên tấm bảng nhà nguyện ba mươi năm trước. Con sông này đã từng thấy bạn, chỉ nó còn giữ ký ức.",
